# AI card generation (server only)
# mock is allowed only in local NODE_ENV=development; never falls back automatically.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Enable only after Firestore rules and server ADC/IAM have been configured.
# Existing local decks stay on this device; new decks use cloud when enabled.
NEXT_PUBLIC_FIRESTORE_SYNC_ENABLED=false
FIRESTORE_SYNC_ENABLED=false
# Optional server project override (must match the Firebase web project).
FIREBASE_PROJECT_ID=
# Server ADC: use gcloud auth application-default login, or an existing server credential file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/server-credentials.json
# Never commit credential JSON or put its contents in NEXT_PUBLIC variables.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8787  # local tests only; never production

# AI generation requires Firestore Admin ADC even when study sync is disabled.
# Explicit activation only after server credentials and budgets are reviewed.
AI_GENERATION_ENABLED=false
AI_DAILY_LIMIT=10
AI_GLOBAL_DAILY_ATTEMPTS=100
# Admission budget units (input bytes + output cap + allowance), NOT a currency cap.
AI_GLOBAL_DAILY_TOKEN_BUDGET=2000000
AI_MAX_OUTPUT_TOKENS=8192
AI_COOLDOWN_SECONDS=5
AI_FAILURE_COOLDOWN_SECONDS=30

# Optional analytics: both flags remain false until collection is approved/configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_ENABLED=false
# Separate approval/configuration for actual external Google Analytics export.
ANALYTICS_EXPORT_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Development only: bypass daily/global generation limits and cooldowns.
AI_GENERATION_UNLIMITED=false

# Optional .env.development.local settings (ignored by Git):
# AI_PROVIDER=mock
# GEMINI_MODEL=gemini-3.1-flash-lite
# AI_GENERATION_ENABLED=true

# Public production origin for sitemap and canonical metadata; configure when domain is known.
SITE_URL=

# Public operator/contact displayed on the policy page (not secrets).
SITE_OPERATOR_NAME=
SUPPORT_EMAIL=
# Set only after checking actual operation, retention, and deletion policies.
PRIVACY_POLICY_CONFIRMED=false

# GA4 browser visitor/event tracking (basic consent mode). OFF by default.
# Rebuild when NEXT_PUBLIC values change. No GA4 API Secret needed for this path.
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_GA4_MANUAL_ONLY_CONFIRMED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_ORIGIN=
# Keep legacy ANALYTICS_ENABLED/ANALYTICS_EXPORT_ENABLED false for browser-only mode.
